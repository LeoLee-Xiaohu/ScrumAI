# LLM Provider (auto-detected from available API keys if not set)
# LLM_PROVIDER=openai

# OpenAI-compatible (works with OpenAI, DeepSeek, Groq, Together, OpenRouter, etc.)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# MiniMax - Anthropic-compatible API (Recommended)
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_API_KEY=your_minimax_api_key
# ANTHROPIC_MODEL=MiniMax-M2.7

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# GitHub (for repo context feature)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Jira REST API (used by jira_client.py — Plan B local direct connect)
# Generate a *classic* API token at https://id.atlassian.com/manage-profile/security/api-tokens
# Token must start with "ATATT". Tokens starting with "ATCTT" are scoped and will
# silently 401 against Jira REST unless explicit Jira scopes were granted — classic
# tokens are simpler because they inherit your account permissions.
# JIRA_BASE_URL=https://yoursite.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=ATATT...
