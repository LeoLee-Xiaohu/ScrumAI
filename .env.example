# LLM Provider (auto-detected from available API keys if not set)
# LLM_PROVIDER=openai

# OpenAI-compatible (works with OpenAI, DeepSeek, Groq, Together, OpenRouter, etc.)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# MiniMax - Anthropic-compatible API (Recommended)
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_API_KEY=your_minimax_api_key
# ANTHROPIC_MODEL=MiniMax-M2.7

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# GitHub (for repo context feature)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
