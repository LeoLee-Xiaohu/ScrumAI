# /etc/scrumai/sync.env — copy to that path with mode 0640 owned by root:scrumai.
# (root owns and writes; the scrumai service user reads via group.)
#
#   sudo install -d -m 0750 -o root -g scrumai /etc/scrumai
#   sudo install -m 0640 -o root -g scrumai deploy/sync.env.example /etc/scrumai/sync.env
#   sudoedit /etc/scrumai/sync.env
#
# The systemd unit reads this via EnvironmentFile=. Anything in here is
# visible to the python process via os.environ.

# --- Jira ---
JIRA_BASE_URL=https://yoursite.atlassian.net
[email protected]
# Classic API token (starts with ATATT). ATCTT scoped tokens silently 401.
JIRA_API_TOKEN=ATATT...

# --- Vibe Kanban (MCP backend) ---
# URL of the kanban backend the MCP adapter talks to. Demo: tunnel from
# kanban.oldcai.com to localhost:3000 already running on this box.
VIBE_BACKEND_URL=http://127.0.0.1:3000

# --- API auth (Forge -> sync) ---
# Shared secret. Forge plugin sends this as `X-API-Key`. Empty disables
# auth entirely — fine for the loopback dev box, NOT fine once exposed.
SCRUMAI_API_KEY=change-me-to-a-long-random-string
